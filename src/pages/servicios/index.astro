---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiciosHero from '@/components/organisms/ServiciosHero.astro';
import ServiciosHub from '@/components/organisms/ServiciosHub.astro';
import { SPOTS } from '@/lib/servicios-hero/spots';
import { FAQ, PRECIOS_ACTUALIZADOS } from '@/lib/servicios/hub';

const SITE = 'https://www.arkava.com.co';
const PAGE = `${SITE}/servicios/`;
const BUSINESS = { '@id': `${SITE}/#business` };
const OG_IMAGE = `${SITE}/og/servicios.jpg`;

// Hub de servicios: página, breadcrumb, catálogo de servicios con precio de
// referencia (cada uno enlaza a su landing y al negocio) y preguntas frecuentes.
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${PAGE}#webpage`,
      url: PAGE,
      name: 'Servicios de remodelación y acabados en Medellín',
      inLanguage: 'es-CO',
      dateModified: PRECIOS_ACTUALIZADOS,
      isPartOf: { '@id': `${SITE}/#website` },
      about: BUSINESS,
      breadcrumb: { '@id': `${PAGE}#breadcrumb` },
      mainEntity: { '@id': `${PAGE}#servicios` },
      primaryImageOfPage: { '@type': 'ImageObject', url: OG_IMAGE, width: 1200, height: 630 },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${PAGE}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: PAGE },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${PAGE}#servicios`,
      name: 'Servicios de remodelación y acabados en Medellín',
      numberOfItems: SPOTS.length,
      itemListElement: SPOTS.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: s.title,
          serviceType: s.label,
          description: s.text,
          url: s.href === '/contacto/' ? PAGE : `${SITE}${s.href}`,
          provider: BUSINESS,
          areaServed: { '@type': 'City', name: 'Medellín' },
          ...(s.priceFrom && {
            offers: {
              '@type': 'Offer',
              priceCurrency: 'COP',
              priceSpecification: {
                '@type': 'UnitPriceSpecification',
                priceCurrency: 'COP',
                minPrice: s.priceFrom,
                referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MTK', unitText: 'm²' },
              },
            },
          }),
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${PAGE}#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Servicios de remodelación y acabados en Medellín | Arkava"
  description="Remodelación y acabados en Medellín con un solo equipo: pintura, enchape, estuco, drywall, cielo raso y carpintería. Precios de referencia 2026."
  ogImage="/og/servicios.jpg"
  schema={schema}
>
  <ServiciosHero />
  <ServiciosHub />
</BaseLayout>
