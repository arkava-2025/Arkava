---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiciosHero from '@/components/organisms/ServiciosHero.astro';
import ServiciosHub from '@/components/organisms/ServiciosHub.astro';
import { SPOTS } from '@/lib/servicios-hero/spots';
import { FAQ } from '@/lib/servicios/hub';

const SITE = 'https://www.arkava.com.co';

// Hub de servicios: breadcrumb, catálogo de servicios (cada uno apunta a su
// landing) y preguntas frecuentes.
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE}/servicios/` },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Servicios de remodelación y acabados en Medellín',
      itemListElement: SPOTS.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: s.title,
          description: s.text,
          url: s.href === '/contacto/' ? `${SITE}/servicios/` : `${SITE}${s.href}`,
          areaServed: { '@type': 'City', name: 'Medellín' },
          provider: { '@type': 'LocalBusiness', name: 'Arkava', url: SITE },
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Servicios de remodelación y acabados en Medellín | Arkava"
  description="Remodelación y acabados en Medellín con un solo equipo: pintura, enchape, estuco, drywall, cielo raso y carpintería. Precios de referencia 2026."
  schema={schema}
>
  <ServiciosHero />
  <ServiciosHub />
</BaseLayout>
