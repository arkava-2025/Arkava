---
import { Picture } from 'astro:assets';
import micro from '@/assets/servicios/decorativos-1.webp';
import relieve from '@/assets/servicios/decorativos-2.webp';
import metal from '@/assets/servicios/decorativos-3.webp';

const ACABADOS = [
  { img: micro, t: 'Microcemento', d: 'Capa continua de 2 a 3 mm, sin juntas de dilatación a la vista. Se aplica sobre muros y pisos existentes bien nivelados.', dato: 'Desde $95.000/m²', alt: 'Muro en microcemento gris con apliques de luz, aplicado por Arkava en Medellín' },
  { img: relieve, t: 'Relieve artesanal', d: 'Texturas modeladas con plantilla y llana. La luz rasante hace visible cada trazo, así que la iluminación se define junto con el muro.', dato: 'Se cotiza por diseño', alt: 'Muro decorativo con relieve artesanal en forma de mandala, obra de Arkava' },
  { img: metal, t: 'Efecto metalizado', d: 'Pigmentos metálicos sobre una base texturizada. El tono cambia según desde dónde se mire y la hora del día.', dato: 'Se cotiza por diseño', alt: 'Detalle de un muro decorativo con acabado metalizado en tonos bronce' },
];
---

<section class="deco" aria-labelledby="deco-t">
  <div class="lnd-wrap">
    <p class="lnd-kicker lnd-kicker--light">Acabados</p>
    <h2 id="deco-t" class="lnd-h2 lnd-h2--light">Tres maneras de vestir un muro</h2>
    <div class="deco__grid" data-deco>
      {
        ACABADOS.map((a, i) => (
          <article class="deco__item" tabindex="0" data-on={i === 0 ? '' : undefined}>
            <Picture fallbackFormat="webp" src={a.img} formats={['avif', 'webp']} widths={[480, 800, 1200].filter((w) => w <= a.img.width)} sizes="(max-width: 1023px) 100vw, 44rem" quality={68} alt={a.alt} />
            <div class="deco__txt">
              <h3 class="deco__t">{a.t}</h3>
              <div class="deco__more">
                <p class="deco__d">{a.d}</p>
                <p class="deco__p">{a.dato}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-deco]').forEach((g) => {
    const items = [...g.querySelectorAll<HTMLElement>('.deco__item')];
    const activar = (el: HTMLElement) => items.forEach((x) => x.toggleAttribute('data-on', x === el));
    items.forEach((el) => {
      el.addEventListener('pointerenter', () => activar(el));
      el.addEventListener('focus', () => activar(el));
      el.addEventListener('click', () => activar(el));
    });
  });
</script>

<style>
  .deco {
    background: #18231f;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .deco__grid {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .deco__grid {
      display: flex;
      height: min(72vh, 42rem);
    }
  }
  .deco__item {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    min-height: 24rem;
    cursor: pointer;
    flex: 1;
    transition: flex 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (min-width: 1024px) {
    .deco__item[data-on] {
      flex: 3.2;
    }
  }
  .deco__item :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .deco__item[data-on] :global(img) {
    transform: scale(1.04);
  }
  .deco__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(12 18 16 / 0.86));
  }
  .deco__txt {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem;
    color: #fff;
  }
  .deco__t {
    font-family: var(--font-pp-sans);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 2.1rem);
  }
  .deco__d {
    font-family: var(--font-helvetica);
    font-size: 16px;
    line-height: 1.55;
    max-width: 46ch;
    margin-top: 0.4rem;
  }
  .deco__p {
    font-family: var(--font-pp-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #f3b089;
    margin-top: 0.6rem;
  }
  @media (min-width: 1024px) {
    .deco__more {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.6s ease,
        opacity 0.5s ease;
      overflow: hidden;
    }
    .deco__more > * {
      min-height: 0;
    }
    .deco__item[data-on] .deco__more {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .deco__item:not([data-on]) .deco__d,
    .deco__item:not([data-on]) .deco__p {
      display: none;
    }
  }
</style>
