---
import {
  PROYECTOS_TIPO,
  ESPECIALIDADES,
  PRECIOS,
  PROCESO,
  GARANTIAS,
  PROYECTOS,
  ZONAS,
  FAQ,
} from '@/lib/servicios/hub';
import { whatsappLink } from '@/lib/utils/whatsapp';

const waHref = whatsappLink(undefined, 'Hola Arkava, quiero cotizar una remodelación');
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="svc">
  <!-- Introducción: búsquedas generales de empresa de remodelación -->
  <section class="svc-sec" aria-labelledby="svc-intro">
    <div class="svc-wrap svc-intro">
      <p class="svc-kicker">Arkava · Medellín y Valle de Aburrá</p>
      <h2 id="svc-intro" class="svc-h2">
        Una empresa de remodelación y acabados en Medellín para toda la obra
      </h2>
      <div class="svc-intro__body">
        <p>
          Arkava hace remodelaciones integrales y acabados arquitectónicos en Medellín y el Valle de
          Aburrá. Trabajamos en apartamentos, casas, locales comerciales y hoteles, y nos hacemos
          cargo de la obra completa: evaluación técnica, diseño, presupuesto, ejecución y entrega.
        </p>
        <p>
          Tienes un solo responsable. El mismo equipo que nivela el muro lo estuca, lo pinta y
          responde por el resultado, con contrato firmado, presupuesto por partidas y pagos según el
          avance.
        </p>
        <p>
          Si tu proyecto es puntual, como enchapar un baño, cambiar un cielo raso o pintar una
          fachada, lo atendemos con la misma exigencia.
        </p>
      </div>
    </div>
  </section>

  <!-- Por tipo de proyecto: lo que la gente busca -->
  <section class="svc-sec svc-sec--alt" aria-labelledby="svc-tipos">
    <div class="svc-wrap">
      <p class="svc-kicker">Por tipo de proyecto</p>
      <h2 id="svc-tipos" class="svc-h2">Remodelación de apartamentos, casas, locales y hoteles</h2>
      <div class="svc-grid svc-grid--3">
        {
          PROYECTOS_TIPO.map((c) => (
            <article class="svc-card">
              <h3 class="svc-card__title">{c.title}</h3>
              <p class="svc-card__text">{c.text}</p>
              {c.price && <p class="svc-card__price">{c.price}</p>}
              <a href={c.href} class="svc-link">
                {c.cta}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Especialidades: enlaces a cada landing -->
  <section class="svc-sec" aria-labelledby="svc-esp">
    <div class="svc-wrap">
      <p class="svc-kicker">Especialidades</p>
      <h2 id="svc-esp" class="svc-h2">Acabados arquitectónicos en Medellín</h2>
      <div class="svc-grid svc-grid--4">
        {
          ESPECIALIDADES.map((c, i) => (
            <article class="svc-card svc-card--line">
              <div class="svc-esp__head">
                {c.icon && (
                  <span class="svc-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      width="26"
                      height="26"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={c.icon}
                    />
                  </span>
                )}
                <p class="svc-num">{pad(i + 1)}</p>
              </div>
              <h3 class="svc-card__title">{c.title}</h3>
              <p class="svc-card__text">{c.text}</p>
              {c.price && <p class="svc-card__price">{c.price}</p>}
              <a href={c.href} class="svc-link">
                {c.cta}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Precios de referencia: datos concretos y citables -->
  <section class="svc-sec svc-sec--green" aria-labelledby="svc-precios">
    <div class="svc-wrap">
      <p class="svc-kicker svc-kicker--light">Precios de referencia 2026</p>
      <h2 id="svc-precios" class="svc-h2 svc-h2--light">
        Cuánto cuesta remodelar en Medellín
      </h2>
      <div class="svc-table-wrap">
        <table class="svc-table">
          <caption class="sr-only">
            Precios de referencia de remodelación y acabados en Medellín, 2026, con mano de obra
          </caption>
          <thead>
            <tr>
              <th scope="col">Servicio</th>
              <th scope="col">Rango de referencia</th>
              <th scope="col">Detalle</th>
            </tr>
          </thead>
          <tbody>
            {
              PRECIOS.map((r) => (
                <tr>
                  <th scope="row">
                    {r.href ? <a href={r.href}>{r.item}</a> : r.item}
                  </th>
                  <td>{r.range}</td>
                  <td>{r.note ?? '—'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="svc-note">
        Valores de referencia en Medellín con mano de obra. Cada proyecto se cotiza después de la
        evaluación técnica, según el estado del espacio y los materiales que elijas.
      </p>
    </div>
  </section>

  <!-- Metodología y garantías: confianza (E-E-A-T) -->
  <section class="svc-sec" aria-labelledby="svc-proceso">
    <div class="svc-wrap svc-split">
      <div>
        <p class="svc-kicker">Cómo trabajamos</p>
        <h2 id="svc-proceso" class="svc-h2">Cinco etapas, un solo equipo</h2>
        <ol class="svc-steps">
          {
            PROCESO.map((s, i) => (
              <li class="svc-step">
                <span class="svc-num">{pad(i + 1)}</span>
                <div>
                  <h3 class="svc-step__title">{s.title}</h3>
                  <p class="svc-card__text">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <p class="svc-kicker">Lo que firmamos contigo</p>
        <h2 class="svc-h2">Garantías de cada obra</h2>
        <ul class="svc-checks">
          {
            GARANTIAS.map((g) => (
              <li>
                <h3 class="svc-step__title">{g.title}</h3>
                <p class="svc-card__text">{g.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Proyectos reales y zonas -->
  <section class="svc-sec svc-sec--alt" aria-labelledby="svc-proyectos">
    <div class="svc-wrap svc-split">
      <div>
        <p class="svc-kicker">Experiencia</p>
        <h2 id="svc-proyectos" class="svc-h2">Proyectos en hoteles y residencias</h2>
        <ul class="svc-projects">
          {
            PROYECTOS.map((p) => (
              <li>
                <a href={p.href} class="svc-project">
                  <span class="svc-project__name">{p.name}</span>
                  <span class="svc-project__kind">{p.kind}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/proyectos/" class="svc-link">
          Ver todos los proyectos <span aria-hidden="true">→</span>
        </a>
      </div>
      <div>
        <p class="svc-kicker">Cobertura</p>
        <h2 class="svc-h2">Dónde trabajamos</h2>
        <h3 class="svc-step__title">Medellín</h3>
        <ul class="svc-tags">{ZONAS.medellin.map((z) => <li>{z}</li>)}</ul>
        <h3 class="svc-step__title">Valle de Aburrá</h3>
        <ul class="svc-tags">{ZONAS.valle.map((z) => <li>{z}</li>)}</ul>
        <h3 class="svc-step__title">Oriente antioqueño</h3>
        <ul class="svc-tags">{ZONAS.oriente.map((z) => <li>{z}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes (con schema FAQPage en la página) -->
  <section class="svc-sec" aria-labelledby="svc-faq">
    <div class="svc-wrap svc-faq">
      <p class="svc-kicker">Preguntas frecuentes</p>
      <h2 id="svc-faq" class="svc-h2">Preguntas sobre remodelación en Medellín</h2>
      <div class="svc-faq__list">
        {
          FAQ.map((f) => (
            <details class="svc-faq__item">
              <summary>
                <h3 class="svc-faq__q">{f.q}</h3>
              </summary>
              <p class="svc-card__text">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="svc-sec svc-sec--green" aria-labelledby="svc-cta">
    <div class="svc-wrap svc-cta">
      <h2 id="svc-cta" class="svc-h2 svc-h2--light">Cuéntanos qué quieres remodelar</h2>
      <p class="svc-cta__text">
        Envíanos fotos o medidas del espacio y te decimos por dónde empezar.
      </p>
      <div class="svc-cta__actions">
        <a href={waHref} class="svc-btn" target="_blank" rel="noopener">Escribir por WhatsApp</a>
        <a href="/contacto/" class="svc-btn svc-btn--ghost">Ir al formulario</a>
      </div>
    </div>
  </section>
</div>

<style>
  .svc {
    --g: #2e483e;
    --c: #f9f6e7;
    --o: #e35205;
    background: var(--c);
    color: var(--g);
  }
  .svc-sec {
    padding: clamp(3.5rem, 8vw, 6.5rem) 1.25rem;
  }
  .svc-sec--alt {
    background: #f1ecd9;
  }
  .svc-sec--green {
    background: var(--g);
    color: var(--c);
  }
  .svc-wrap {
    max-width: 80rem;
    margin: 0 auto;
  }
  .svc-kicker {
    font-family: var(--font-pp-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--o);
    margin-bottom: 0.9rem;
  }
  .svc-kicker--light {
    color: #f3b089;
  }
  .svc-h2 {
    font-family: var(--font-pp-sans);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 24ch;
    margin-bottom: 2.25rem;
  }
  .svc-h2--light {
    color: var(--c);
  }
  .svc-intro {
    display: grid;
    gap: 0 4rem;
  }
  .svc-intro__body {
    display: grid;
    gap: 1rem;
    font-family: var(--font-helvetica);
    font-size: 17px;
    line-height: 1.7;
    color: rgb(46 72 62 / 0.85);
    max-width: 62ch;
  }
  @media (min-width: 1024px) {
    .svc-intro {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .svc-intro .svc-kicker {
      grid-column: 1 / -1;
    }
  }

  .svc-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .svc-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .svc-grid--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem;
    border-radius: 1rem;
    background: #fffdf4;
    box-shadow: 0 1px 0 rgb(46 72 62 / 0.08);
  }
  .svc-card--line {
    background: transparent;
    box-shadow: none;
    border-top: 1px solid rgb(46 72 62 / 0.2);
    border-radius: 0;
    padding: 1.25rem 0 0;
  }
  .svc-card__title,
  .svc-step__title {
    font-family: var(--font-pp-sans);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .svc-card__text {
    font-family: var(--font-helvetica);
    font-size: 15px;
    line-height: 1.65;
    color: rgb(46 72 62 / 0.78);
  }
  .svc-card__price {
    font-family: var(--font-pp-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--o);
  }
  .svc-esp__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .svc-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.9rem;
    background: rgb(46 72 62 / 0.07);
    color: var(--g);
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }
  .svc-card--line:hover .svc-icon {
    background: var(--g);
    color: var(--c);
    transform: translateY(-2px);
  }
  .svc-card--line:hover .svc-icon svg {
    color: #f3b089;
  }
  .svc-num {
    font-family: var(--font-pp-mono);
    font-size: 11px;
    color: var(--o);
  }
  .svc-link {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-family: var(--font-pp-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--g);
    text-decoration: underline;
    text-decoration-color: rgb(227 82 5 / 0.5);
    text-underline-offset: 4px;
  }
  .svc-link:hover {
    color: var(--o);
  }

  .svc-table-wrap {
    overflow-x: auto;
    border-radius: 1rem;
    border: 1px solid rgb(249 246 231 / 0.18);
  }
  .svc-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-family: var(--font-helvetica);
    font-size: 15px;
  }
  .svc-table th,
  .svc-table td {
    padding: 0.95rem 1.2rem;
    text-align: left;
    border-bottom: 1px solid rgb(249 246 231 / 0.12);
  }
  .svc-table thead th {
    font-family: var(--font-pp-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f3b089;
  }
  .svc-table tbody th {
    font-family: var(--font-pp-sans);
    font-weight: 700;
  }
  .svc-table tbody th a {
    text-decoration: underline;
    text-decoration-color: rgb(243 176 137 / 0.6);
    text-underline-offset: 4px;
  }
  .svc-table td:nth-child(2) {
    font-family: var(--font-pp-mono);
    font-size: 13px;
    white-space: nowrap;
  }
  .svc-table td:last-child {
    color: rgb(249 246 231 / 0.7);
  }
  .svc-note {
    margin-top: 1.25rem;
    font-family: var(--font-helvetica);
    font-size: 14px;
    color: rgb(249 246 231 / 0.7);
    max-width: 70ch;
  }

  .svc-split {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 1024px) {
    .svc-split {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
  .svc-steps,
  .svc-checks {
    display: grid;
    gap: 1.4rem;
  }
  .svc-step {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
  }
  .svc-checks li {
    padding-left: 1.4rem;
    border-left: 2px solid var(--o);
  }

  .svc-projects {
    display: grid;
    gap: 0;
    margin-bottom: 1.5rem;
  }
  .svc-project {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(46 72 62 / 0.18);
  }
  .svc-project__name {
    font-family: var(--font-pp-sans);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .svc-project__kind {
    font-family: var(--font-pp-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(46 72 62 / 0.6);
  }
  .svc-project:hover .svc-project__name {
    color: var(--o);
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 1.5rem;
  }
  .svc-tags li {
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgb(46 72 62 / 0.25);
    font-family: var(--font-helvetica);
    font-size: 14px;
  }

  .svc-faq {
    max-width: 56rem;
  }
  .svc-faq__list {
    border-top: 1px solid rgb(46 72 62 / 0.2);
  }
  .svc-faq__item {
    border-bottom: 1px solid rgb(46 72 62 / 0.2);
    padding: 1.1rem 0;
  }
  .svc-faq__item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .svc-faq__item summary::-webkit-details-marker {
    display: none;
  }
  .svc-faq__item summary::after {
    content: '+';
    font-family: var(--font-pp-mono);
    color: var(--o);
    font-size: 1.25rem;
  }
  .svc-faq__item[open] summary::after {
    content: '–';
  }
  .svc-faq__q {
    font-family: var(--font-pp-sans);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .svc-faq__item p {
    margin-top: 0.75rem;
    max-width: 70ch;
  }

  .svc-cta {
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .svc-cta .svc-h2 {
    margin-bottom: 1rem;
  }
  .svc-cta__text {
    font-family: var(--font-helvetica);
    font-size: 17px;
    color: rgb(249 246 231 / 0.8);
    margin-bottom: 2rem;
  }
  .svc-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .svc-btn {
    padding: 0.9rem 1.5rem;
    border-radius: 9999px;
    background: var(--o);
    color: #fff;
    font-family: var(--font-pp-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .svc-btn:hover {
    background: #c94804;
  }
  .svc-btn--ghost {
    background: transparent;
    border: 1px solid rgb(249 246 231 / 0.4);
  }
  .svc-btn--ghost:hover {
    background: rgb(249 246 231 / 0.08);
  }
  .svc a:focus-visible,
  .svc summary:focus-visible {
    outline: 2px solid var(--o);
    outline-offset: 3px;
  }
</style>
