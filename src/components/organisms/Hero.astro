---
import Carousel from '@/components/molecules/Carousel.jsx';
const { data } = Astro.props;

// La imagen fija es lo primero que se pinta; el video entra cuando la página ya cargó.
const CLOUDINARY = 'https://res.cloudinary.com/dx9vtev71/video/upload';
const MOVIL = 'v1764353621/mobile_1_gblhox';
const DESKTOP = 'v1764281243/hero-bf_ab0mgf';
const poster = (id: string, ancho: number) =>
  `${CLOUDINARY}/so_0,f_auto,q_auto,w_${ancho}/${id}.jpg`;
---

<section class="relative w-full h-[80vh] md:h-[85vh] overflow-hidden">
  <div class="absolute inset-0">
    <!-- <Carousel client:only="react"> -->
    <picture>
      <source
        media="(min-width: 768px)"
        srcset={`${poster(DESKTOP, 1280)} 1280w, ${poster(DESKTOP, 1920)} 1920w`}
        sizes="100vw"
      />
      <img
        src={poster(MOVIL, 828)}
        srcset={`${poster(MOVIL, 480)} 480w, ${poster(MOVIL, 828)} 828w, ${poster(MOVIL, 1080)} 1080w`}
        sizes="100vw"
        alt="Espacio remodelado por Arkava en Medellín"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </picture>
    <video
      data-hero-video
      data-movil={`${CLOUDINARY}/${MOVIL}.mp4`}
      data-desktop={`${CLOUDINARY}/${DESKTOP}.mp4`}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"></video>
    <!-- </Carousel> -->
  </div>

  {/* Overlay para mejorar contraste del texto (opcional) */}
  <!-- <div class="absolute inset-0 bg-black/20 pointer-events-none"></div> -->

  <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent">
  </div>

  {/* Contenido centrado */}
  <div class="relative z-10 flex items-center justify-center h-full">
    <div
      class="mx-auto max-w-6xl px-6 text-center text-white absolute md:bottom-[30px]"
    >
      <h1
        class="text-4xl md:text-6xl font-pp-sans text-white drop-shadow-[0_4px_6px_rgba(0,0,0,1)]"
      >
        {data?.title}
      </h1>
      {
        data?.description && (
          <p class="mt-4 text-base md:text-lg opacity-95 text-white drop-shadow-[0_4px_6px_rgba(0,0,0,1)] md:w-[70%] w-full mx-auto">
            {data.description}
          </p>
        )
      }
      <div class="mt-6 flex items-center justify-center">
        <a
          href="/servicios/"
          class="bg-tertiary hover:bg-tertiary/80 text-white font-semibold py-2.5 px-5 rounded-md shadow"
        >
          Conoce nuestros servicios
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (video && !conexion?.saveData && !sinMovimiento) {
    const cargar = () => {
      video.src = window.matchMedia('(min-width: 768px)').matches
        ? video.dataset.desktop!
        : video.dataset.movil!;
      video.muted = true;
      video.addEventListener('playing', () => video.classList.remove('opacity-0'), { once: true });
      void video.play().catch(() => {});
    };
    const programar = () => {
      if ('requestIdleCallback' in window) requestIdleCallback(cargar, { timeout: 2500 });
      else setTimeout(cargar, 1200);
    };
    if (document.readyState === 'complete') programar();
    else window.addEventListener('load', programar, { once: true });
  }
</script>
